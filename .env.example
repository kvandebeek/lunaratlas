# Settings for the lunar tools: lunaratlas, lunar_finish, mosaic_builder, panel_classifier.
# Copy to .env (not committed) and uncomment what you change. Written by `python3 tool_settings.py --example`
# from the SPECS in tool_settings.py, so the ranges here are the ones the tools enforce.
# Precedence: command-line option > environment variable > .env > this default.
# Out-of-range values and unknown keys are reported and the default is used.

# ---- Observing site (only the parallax of the lunar ephemeris: up to 1° of libration)
#   a name for the site (shown nowhere yet)
# LUNARATLAS_OBSERVER_NAME=Belgium
#   latitude, ° north · range -90 – 90
# LUNARATLAS_OBSERVER_LAT=50.9
#   longitude, ° east · range -180 – 180
# LUNARATLAS_OBSERVER_LON=4.4
#   height above sea level, m · range -500 – 9000
# LUNARATLAS_OBSERVER_HEIGHT_M=50.0

# ---- Equipment (close-up search and the optics prompt)
#   telescope name, used in the info block
# LUNARATLAS_TELESCOPE=250 PDS
#   native focal length, mm · range 50 – 30000
# LUNARATLAS_FOCAL_MM=1200.0
#   focal extenders as name:factor, comma-separated; factor per entry · range 0.2 – 10
# LUNARATLAS_EXTENDERS=native:1, 2× ES Focal Extender:2, 2.5× TV Powermate:2.5, 3× ES Focal Extender:3
#   cameras as name:pixel size in µm, comma-separated; µm per entry · range 0.5 – 30
# LUNARATLAS_CAMERAS=IMX678:2.0, IMX533:3.76, IMX462:2.9

# ---- lunaratlas export (labelled images)
#   output format when -o does not decide it · range one of tiff | png | jpg
# LUNARATLAS_FORMAT=tiff
#   longest output side in px (never upscaled); 0 = 1:1 · range 0 – 100000
# LUNARATLAS_MAX_SIZE=0
#   view size W x H in source px for --around NAME
# LUNARATLAS_AROUND_SIZE=3000x2000
#   smallest crater that gets a name, apparent diameter in output px · range 4 – 400 · typical 16–40
# LUNARATLAS_MIN_SIZE=24.0
#   label font: IBM Plex Sans, Source Sans 3 or Roboto (bundled, as in the viewer), or any Google Fonts family (downloaded once)
# LUNARATLAS_FONT=IBM Plex Sans
#   label size factor · range 0.3 – 5 · typical 0.8–1.6
# LUNARATLAS_FONT_SCALE=1.0
#   names on the unlit side · range one of hide | dim | show
# LUNARATLAS_NIGHT=dim
#   which names, comma-separated, or none · range one or more of area | crater | lettered | relief | landing | none
# LUNARATLAS_LAYERS=area,crater,lettered,relief,landing
#   crater outlines in exports
# LUNARATLAS_RIMS=1
#   lettered satellite craters (Copernicus A, …)
# LUNARATLAS_LETTERED=1
#   landing sites
# LUNARATLAS_LANDING=1
#   lat/lon grid in exports
# LUNARATLAS_GRID=1
#   the viewer's drawings and measurements in exports
# LUNARATLAS_DRAWINGS=1
#   info block (date, optics, scale bar, N/E arrows) in exports
# LUNARATLAS_INFO=1
#   JPEG quality · range 0 – 100 · typical 85–95
# LUNARATLAS_JPEG_QUALITY=92

# ---- lunaratlas viewer
#   first port to try (the next free one is used) · range 1024 – 65535
# LUNARATLAS_VIEW_PORT=8766
#   open the browser when the viewer starts
# LUNARATLAS_VIEW_OPEN=1

# ---- lunar_finish: wavelet sharpening (first step; à trous wavelet transform on lightness)
#   empty = off; 'classic' = 4 layers, linear (3), layer 1 bias +3; or 1–8 comma-separated layer biases, layer weight = 1 + bias; each bias ≥ −1 (−1 removes the layer, 0 keeps it); typical 0–4 for layer 1, less for coarser layers
# LUNAR_FINISH_WAVELETS=
#   scaling function: linear = 'Linear Interpolation (3)', b3 = 'B3 Spline (5)' · range one of linear | b3
# LUNAR_FINISH_WAVELET_KERNEL=linear
#   per layer, comma-separated: coefficients within K × the layer's noise keep weight 1; each K ≥ 0; 0 or empty = off; typical 0.5–3
# LUNAR_FINISH_WAVELET_DENOISE=

# ---- lunar_finish: unsharp mask (as Photoshop; optional, after contrast)
#   empty = off; AMOUNT,RADIUS,THRESHOLD, e.g. 100,1.5,0 or "100;1,5;0": amount ≥ 0 % (Photoshop 1–500 %), radius > 0 px (Gaussian σ; Photoshop 0.1–1000), threshold 0–255 levels; typical 50–150 %, 0.5–2 px, 0–6 levels
# LUNAR_FINISH_USM=
#   luminosity = brightness only (no colour fringes); rgb = every channel, as Photoshop in RGB mode · range one of luminosity | rgb
# LUNAR_FINISH_USM_MODE=luminosity

# ---- lunar_finish: tone, colour and orientation
#   fraction by which the knee-to-top span is lowered; 0 = off · range 0 – 0.5 (excl.) · typical 0.2–0.4
# LUNAR_FINISH_HIGHLIGHTS=0.3
#   highlight roll-off starts at this brightness percentile of the disk · range 0 (excl.) – 99.9 (excl.) · typical 85–95
# LUNAR_FINISH_KNEE_PERCENTILE=90.0
#   saturation factor on the lunar hues per pass; 1 = off · range 0 (excl.) – 10 · typical 1.5–3
# LUNAR_FINISH_SATURATION=2.0
#   how many times the saturation boost is applied · range 0 – 10 · typical 1–3
# LUNAR_FINISH_SATURATION_PASSES=2
#   midtone contrast increase (0.12 = +12 %); 0 = off · range 0 – 0.5 (excl.) · typical 0.05–0.2
# LUNAR_FINISH_CONTRAST=0.12
#   colour-only smoothing before the saturation boost, px (Gaussian σ); 0 = off · range 0 – 50 · typical 2–4
# LUNAR_FINISH_CHROMA_DENOISE=3.0
#   px inside the limb without extra saturation (colour fringing) · range 0 – 2000
# LUNAR_FINISH_LIMB_TAPER=80.0
#   last step: turn lunar north up, east right (never mirrored)
# LUNAR_FINISH_NORTH_UP=1
#   live preview window
# LUNAR_FINISH_PREVIEW=1
#   also write <out>_display.tif (the movie tone mapping)
# LUNAR_FINISH_DISPLAY_TIF=1

# ---- mosaic_builder
#   pose model for fine alignment · range one of poly3+mesh | poly3 | poly2 | affine | similarity
# MOSAIC_MODEL=poly3+mesh
#   turn the mosaic itself north up (normally lunar_finish does it)
# MOSAIC_NORTH_UP=0
#   parallel worker threads · range 1 – 256
# MOSAIC_WORKERS=9
#   proxy downscale factor for pair discovery (4 = 0.25×) · range 1 – 16
# MOSAIC_PROXY_FACTOR=4
#   SIFT keypoints per panel (on the proxy) · range 100 – 50000 · typical 2000–8000
# MOSAIC_FEATURES=4000
#   panels with fewer keypoints are not placed · range 0 – 50000
# MOSAIC_MIN_KEYPOINTS=150
#   index = one feature index over all panels (fast); all = every pair · range one of index | all
# MOSAIC_PAIR_SEARCH=index
#   correspondences per pair in the global solve · range 1 – 10000
# MOSAIC_MAX_POINTS=300
#   multi-band pyramid levels · range 1 – 10
# MOSAIC_LEVELS=7
#   px cropped at every frame edge: auto (measured artefact + 3 px) or 0–499
# MOSAIC_BORDER=auto
#   neutral-black = neutral sky, then black space; neutral = neutral sky only; keep = unchanged · range one of neutral-black | neutral | keep
# MOSAIC_BACKGROUND=neutral-black
#   px cosine ramp from the limb to black · range 0 – 1000
# MOSAIC_LIMB_FEATHER=12
#   highlands = neutral grey highlands; disk = neutral whole disk; none · range one of highlands | disk | none
# MOSAIC_COLOUR_BALANCE=highlands
#   live preview window
# MOSAIC_PREVIEW=1
#   also write <out>_display.tif (the movie tone mapping)
# MOSAIC_DISPLAY_TIF=1

# ---- panel_classifier
#   px trimmed from every edge · range 0 – 499
# MOSAIC_CLASSIFIER_BORDER=32
#   px removed along a real subject edge · range 0 – 1000
# MOSAIC_CLASSIFIER_ERODE=40
#   percentile cut points, comma-separated, each 0–100
# MOSAIC_CLASSIFIER_TIERS=10,25,75
#   px: overlapping images compared at equal distance from their frame centres, within this · range 1 – 5000
# MOSAIC_CLASSIFIER_RADIUS_TOL=200
#   parallel worker threads · range 1 – 256
# MOSAIC_CLASSIFIER_WORKERS=8
